DISCORD_TOKEN=your_discord_bot_token

# Optional: use a guild id while testing so slash commands appear immediately.
DISCORD_GUILD_ID=your_discord_server_id

# Optional: required only for AI-written articles. Without it, the bot uses a deterministic recap.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4

JOURNALIST_NAME=El Insider de la Liga
DATA_FILE=data/league-journalist.json
QUESTION_FILE=config/questions.json
