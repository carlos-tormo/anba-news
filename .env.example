DISCORD_TOKEN=your_discord_bot_token

# Opcional: usa un guild id durante pruebas para que los comandos aparezcan rápido.
DISCORD_GUILD_ID=your_discord_server_id

# IDs de Discord separados por comas que pueden usar comandos admin (/gm y /periodista).
BOT_ADMIN_USER_IDS=your_discord_user_id

# Opcional: solo necesario para noticias y preguntas redactadas por IA.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.4

JOURNALIST_NAME=El Insider de la Liga
DATA_FILE=data/league-journalist.json
QUESTION_FILE=config/questions.json

# Opcional: permite usar rosters, assets de draft y economía desde la app ANBA Excel.
ANBA_EXCEL_BASE_URL=https://anba-excel-production.up.railway.app
